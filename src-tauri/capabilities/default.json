{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Orbyt main window access",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/login/device" }]
    }
  ]
}
